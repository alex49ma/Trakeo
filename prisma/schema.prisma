generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  clerkUserId  String        @unique
  email        String        @unique
  name         String?
  imageUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accounts     Account[]
  budgets      Budget?
  categories   Category[]
  feedbacks    Feedback[]
  transactions Transaction[]
  transfers    Transfer[]

  @@map("users")
}

model Account {
  id           String        @id @default(uuid())
  name         String
  type         AccountType
  balance      Decimal       @default(0)
  currency     String        @default("EUR") @db.VarChar(3)
  isDefault    Boolean       @default(false)
  userId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  transfersOut Transfer[]    @relation("TransferFrom")
  transfersIn  Transfer[]    @relation("TransferTo")

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id                String             @id @default(uuid())
  type              TransactionType
  amount            Decimal
  description       String?
  date              DateTime
  receiptUrl        String?
  isRecurring       Boolean            @default(false)
  recurringInterval RecurringInterval?
  nextRecurringDate DateTime?
  lastProcessed     DateTime?
  status            TransactionStatus  @default(COMPLETED)
  userId            String
  accountId         String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  categoryId        String
  subcategoryId     String?
  transferId        String?
  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory       Subcategory?       @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  transfer          Transfer?          @relation(fields: [transferId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([transferId])
  @@map("transactions")
}

/// One internal transfer between two of a user's accounts. Its transactions (outgoing, incoming and an optional fee) point back here through transferId.
model Transfer {
  id            String        @id @default(uuid())
  userId        String
  fromAccountId String
  toAccountId   String
  fromAmount    Decimal
  fee           Decimal       @default(0)
  rate          Decimal       @db.Decimal(20, 10)
  toAmount      Decimal
  derivedField  ExchangeField
  date          DateTime
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount   Account       @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: NoAction)
  toAccount     Account       @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: NoAction)
  transactions  Transaction[]

  @@index([userId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfers")
}

model Budget {
  id            String    @id @default(uuid())
  amount        Decimal
  currency      String    @default("EUR") @db.VarChar(3)
  lastAlertSent DateTime?
  userId        String    @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("budgets")
}

model Category {
  id            String          @id @default(uuid())
  name          String
  type          TransactionType
  color         String
  systemKey     SystemCategory?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subCategories Subcategory[]
  transactions  Transaction[]

  @@unique([userId, systemKey])
  @@map("categories")
}

model Subcategory {
  id           String        @id @default(uuid())
  name         String
  category_id  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  category     Category      @relation(fields: [category_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([category_id])
  @@map("subcategories")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Feedback {
  id         BigInt   @id @default(autoincrement())
  message    String
  userId     String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  users      User?    @relation(fields: [userId], references: [id])

  @@map("feedbacks")
}

/// ECB euro reference rates: 1 EUR = rate units of currency on that date. Shared by every user; only the Inngest job writes here
model ExchangeRate {
  id        String             @id @default(uuid())
  date      DateTime           @db.Date
  currency  String             @db.VarChar(3)
  rate      Decimal            @db.Decimal(20, 10)
  source    ExchangeRateSource
  createdAt DateTime           @default(now())

  @@unique([currency, date])
  @@map("exchange_rates")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CURRENT
  SAVINGS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

// Built-in categories every user gets. Nobody can edit or delete them; the TRANSFER_* ones are reserved for internal transfers
enum SystemCategory {
  OTHER_EXPENSES
  OTHER_INCOME
  TRANSFER_OUT
  TRANSFER_IN
  TRANSFER_FEE
}

// Which of the three exchange values the app calculated from the other two
enum ExchangeField {
  FROM_AMOUNT
  RATE
  TO_AMOUNT
}

// Where a stored exchange rate came from. Both serve the ECB's numbers
enum ExchangeRateSource {
  ECB
  FRANKFURTER
}
